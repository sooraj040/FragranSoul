# Copy this file to ".env" on the server and fill in the secret key.
# Never upload a real .env anywhere public.

# A long random string. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-me

# 0 on the live site. Never run the live site with 1.
DJANGO_DEBUG=0

DJANGO_ALLOWED_HOSTS=fragransoul.in,www.fragransoul.in
DJANGO_CSRF_TRUSTED_ORIGINS=https://fragransoul.in,https://www.fragransoul.in

# Online payments (UPI, net banking, cards) through Razorpay. Leave empty to
# offer cash on delivery only. Use the "test" keys first, then the "live" ones.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
